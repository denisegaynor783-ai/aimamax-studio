# ===== AIMAMAX 后端环境变量（复制为 .env 填写，切勿提交真实密钥） =====

# —— ToAPIs 统一模型网关 ——
TOAPIS_BASE=https://toapis.com/v1
TOAPIS_KEY=

# —— 鉴权 ——
# 演示/开发期允许匿名调用生成接口（画布立即可用）；生产设 0 强制微信登录
ALLOW_ANON=1
# JWT 签名密钥（生产务必改为随机长串）
JWT_SECRET=dev-insecure-secret-change-me
FRONTEND_URL=https://ninedeerselect.com

# —— 微信登录（网站应用） ——
WECHAT_APPID=
WECHAT_SECRET=

# —— 微信支付（商户） ——
WXPAY_MCH_ID=
WXPAY_API_KEY=
WXPAY_APPID=
